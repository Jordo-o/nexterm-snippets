# @name: postgresql | Backup Database (Compressed)
# @description: Creates a compressed backup of a database Group: PostgreSQL Backup and Restore. Template: replace placeholders before running. {host} = Database host [default "localhost"] | {port} = Database port [default "5432"] | {username} = Database username [default "postgres"] | {database_name} = Name of the database to backup | {backup_file} = Name of the compressed backup file [default "backup.sql.gz"]
pg_dump -h {host} -p {port} -U {username} -d {database_name} | gzip > {backup_file}