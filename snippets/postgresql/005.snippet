# @name: postgresql | Create Database
# @description: Creates a new database Group: PostgreSQL Database Management. Template: replace placeholders before running. {host} = Database host [default "localhost"] | {port} = Database port [default "5432"] | {username} = Database username [default "postgres"] | {database_name} = Name of the database to create
createdb -h {host} -p {port} -U {username} {database_name}