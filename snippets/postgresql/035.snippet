# @name: postgresql | Restore Compressed Backup
# @description: Restores a database from a compressed backup Group: PostgreSQL Backup and Restore. Template: replace placeholders before running. {backup_file} = Name of the compressed backup file [default "backup.sql.gz"] | {host} = Database host [default "localhost"] | {port} = Database port [default "5432"] | {username} = Database username [default "postgres"] | {database_name} = Name of the database to restore
gunzip -c {backup_file} | psql -h {host} -p {port} -U {username} -d {database_name}