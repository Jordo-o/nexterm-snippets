# @name: postgresql | Backup Database
# @description: Creates a backup of a database Group: PostgreSQL Backup and Restore. Template: replace placeholders before running. {host} = Database host [default "localhost"] | {port} = Database port [default "5432"] | {username} = Database username [default "postgres"] | {database_name} = Name of the database to backup | {backup_file} = Name of the backup file [default "backup.sql"]
pg_dump -h {host} -p {port} -U {username} -d {database_name} > {backup_file}