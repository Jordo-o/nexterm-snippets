# @name: aws | Create Lambda Function
# @description: Creates a new Lambda function Group: AWS Lambda Commands. Template: replace placeholders before running. {function_name} = Name of the Lambda function | {runtime} = Runtime (e.g., python3.9, nodejs18.x) [default "python3.9"] | {role_arn} = ARN of the execution role | {handler} = Handler function [default "index.handler"] | {zip_file} = Path to deployment package
aws lambda create-function --function-name {function_name} --runtime {runtime} --role {role_arn} --handler {handler} --zip-file fileb://{zip_file}