# @name: nginx | Generate SSL Certificate with Subject
# @description: Generates SSL certificate with specific subject information Group: Nginx SSL/TLS Management. Template: replace placeholders before running. {days} = Certificate validity in days [default "365"] | {key_file} = Private key file path [default "/etc/nginx/ssl/private.key"] | {cert_file} = Certificate file path [default "/etc/nginx/ssl/certificate.crt"] | {country} = Country code (e.g., US) [default "US"] | {state} = State or province [default "CA"] | {city} = City name [default "San Francisco"] | {organization} = Organization name [default "My Company"] | {domain} = Domain name [default "example.com"]
sudo openssl req -x509 -nodes -days {days} -newkey rsa:2048 -keyout {key_file} -out {cert_file} -subj "/C={country}/ST={state}/L={city}/O={organization}/CN={domain}"