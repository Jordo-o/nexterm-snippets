# @name: nginx | Generate SSL Certificate
# @description: Generates a self-signed SSL certificate Group: Nginx SSL/TLS Management. Template: replace placeholders before running. {days} = Certificate validity in days [default "365"] | {key_file} = Private key file path [default "/etc/nginx/ssl/private.key"] | {cert_file} = Certificate file path [default "/etc/nginx/ssl/certificate.crt"]
sudo openssl req -x509 -nodes -days {days} -newkey rsa:2048 -keyout {key_file} -out {cert_file}